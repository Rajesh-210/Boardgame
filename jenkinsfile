
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Docker') {
            steps {
                sh 'docker version'
            }
        }
        stage('Check Java Environment') {
            steps {
                sh '''
                java -version
                bash ./mvnw -version
                '''
           }
        }

        stage('Maven Unit Tests') {
            steps {
                sh 'bash ./mvnw -B test'
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t boardgame:latest .'
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                trivy image \
                --severity HIGH,CRITICAL \
                --exit-code 1 \
                boardgame:latest
            '''
           }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    docker rm -f boardgame-test || true

                    docker run -d \
                      --name boardgame-test \
                      --restart unless-stopped \
                      -p 8081:8080 \
                      boardgame:latest
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    sleep 10
                    docker ps --filter name=boardgame-test
                    curl --fail --retry 5 --retry-delay 3 \
                      http://localhost:8081/
                '''
            }
        }
    }
}
